# Скопируйте в .env. Никогда не коммитьте реальные значения.
POSTGRES_DB=maxbot
POSTGRES_USER=maxbot
POSTGRES_PASSWORD=replace-with-strong-password
# В Compose используется адрес db; для запуска Python на хосте — localhost.
# При спецсимволах в пароле закодируйте их в DATABASE_URL (URL encoding).
DATABASE_URL=postgresql://maxbot:replace-with-strong-password@db:5432/maxbot
MAX_BOT_TOKEN=
# Стабильный user_id первого администратора MAX > 0.
# 0 отключает начальное назначение, пока вы узнаете свой ID через /мой_id.
INITIAL_ADMIN_MAX_ID=0
ORG_TIMEZONE=Asia/Omsk
MAX_API_URL=https://platform-api2.max.ru
# Сгенерируйте: python -c "import secrets; print(secrets.token_urlsafe(48))"
MAX_WEBHOOK_SECRET=
MAX_WEBHOOK_URL=https://your-company.example/webhook/max
# Точные хосты, возвращаемые официальным POST /uploads; через запятую, без схемы/пути.
# Узнать без вывода подписанного URL: python -m app upload-host
MAX_UPLOAD_ALLOWED_HOSTS=
# Необязательно: путь к PEM дополнительных доверенных CA. Проверка TLS всегда включена.
MAX_CA_BUNDLE=
