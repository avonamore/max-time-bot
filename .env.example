# Токен из MAX для бизнеса. Не добавляйте .env в Git.
MAX_BOT_TOKEN=
# Числовой стабильный MAX user_id первого администратора
ADMIN_MAX_ID=123456789
# Замените: python -c 'import secrets; print(secrets.token_urlsafe(32))'
MAX_WEBHOOK_SECRET=replace_with_random_secret_32_chars
ORG_TIMEZONE=Asia/Omsk
PUBLIC_BASE_URL=https://bot.example.ru
POSTGRES_DB=maxbot
POSTGRES_USER=maxbot
POSTGRES_PASSWORD=replace_with_random_database_password
DATABASE_URL=postgresql://maxbot:replace_with_random_database_password@db:5432/maxbot
MAX_API_BASE=https://platform-api2.max.ru
# Дополнительный доверенный CA PEM (например сертификаты Минцифры); TLS не отключается.
MAX_CA_BUNDLE=
# Только проверенные HTTPS-хосты загрузки, полученные от MAX; точные имена через запятую.
MAX_UPLOAD_HOSTS=fu.oneme.ru,omu.okcdn.ru,omub.okcdn.ru
